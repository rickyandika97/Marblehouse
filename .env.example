# Template. Copy to .env and fill in. .env is gitignored and must never be committed.
# Generate secrets with:  openssl rand -hex 32

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=marblehouse
POSTGRES_PASSWORD=
POSTGRES_DB=marblehouse

# Dev on a machine with Postgres installed natively (Homebrew, Postgres.app):
DATABASE_URL=postgresql://YOURUSER@localhost:5432/marblehouse_dev
# Production in Docker — the app talks to the "postgres" compose service:
# DATABASE_URL=postgresql://marblehouse:CHANGEME@postgres:5432/marblehouse

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=production
TZ=Asia/Jakarta
APP_URL=http://localhost:5050
PORT=5050
# Better Auth's signing secret (PRD §5.4). Generate 64 hex chars:
#   openssl rand -hex 32
# Changing it invalidates every existing session — everyone is logged out.
SESSION_SECRET=
# Rolling session window. 12h is long enough for a shift, short enough that a
# tablet left at a shop overnight is logged out by morning.
SESSION_TTL_HOURS=12
TRUST_PROXY=false

# ── Seed (required on first boot; startup fails loudly if unset) ──────────
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=
SEED_SHOP_NAME=Branch 1

# ── Storage & retention ──────────────────────────────────────────────────
DATA_DIR=/data
BACKUP_DIR=/backups
ATTENDANCE_PHOTO_RETENTION_DAYS=61
BACKUP_RETENTION_DAYS=7
BACKUP_CRON=0 2 * * *

# ── Business rules ───────────────────────────────────────────────────────
# Ticket awards above this size require a reason note (PRD §4.6).
TICKET_AWARD_REASON_THRESHOLD=500

# ── Cloudflare Tunnel (only needed on the production machine) ─────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Optional: automated off-machine backup copy (currently manual, PRD §13.4)
#
# DELIBERATELY UNSET. The owner decided on 8 Aug 2026 to copy backups off the
# machine by hand, and declined both the automatic USB copy and backup
# encryption (BUILD-LOG D-71, D-72). The app compensates with a one-tap export,
# a copy log, and a dashboard alert that turns red — undismissably — after 14
# days without a copy.
#
# If you change your mind: automating this is a small addition to
# scripts/backup.ts and nothing else in the system needs to change.
RCLONE_REMOTE=
