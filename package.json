{
  "name": "marblehouse",
  "version": "0.1.0",
  "private": true,
  "description": "Pinball arcade management system — sales, marble & ticket balances, FIFO prize inventory, attendance, reporting.",
  "scripts": {
    "dev": "next dev -p 5050",
    "build": "prisma generate && next build",
    "start": "next start -p 5050",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "balances:reconcile": "tsx --env-file=.env scripts/reconcile-balances.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.7.1",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.13.0",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^15.4.10",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "prisma": "6.13.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.84.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "4.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "22.17.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.32.0",
    "eslint-config-next": "^15.4.10",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
